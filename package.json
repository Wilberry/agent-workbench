{
  "name": "agent-workbench",
  "private": true,
  "version": "0.4.0",
  "packageManager": "pnpm@10.34.2",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:worker": "pnpm --filter @agent-workbench/agent-runtime... build && node scripts/ci/prepare-worker-runtime.mjs",
    "start:worker": "node packages/agent-runtime/dist/productionWorker.js",
    "lint": "turbo run lint",
    "typecheck": "tsc -b && tsc -p apps/web/tsconfig.json --noEmit",
    "validate": "pnpm lint && pnpm typecheck && pnpm build && pnpm test:unit",
    "test": "pnpm test:unit",
    "test:all": "pnpm test:unit && pnpm test:integration && pnpm test:security && pnpm test:reliability",
    "test:unit": "vitest run --config vitest.config.ts --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:security": "vitest run --config vitest.security.config.ts",
    "test:reliability": "vitest run --config vitest.reliability.config.ts",
    "seed:reliability-data": "node scripts/seed-reliability-data.js",
    "test:reliability:ci": "vitest run --config vitest.reliability.config.ts --reporter json > test-results.json; test_exit=$?; node scripts/ci/report-vitest.js test-results.json; report_exit=$?; test $test_exit -eq 0 && test $report_exit -eq 0",
    "test:playwright": "playwright test",
    "test:performance": "k6 run tests/performance/load_test.js",
    "test:e2e": "pnpm test:playwright",
    "smoke:deployment": "node scripts/ci/smoke-deployment.mjs",
    "ops:queue-health": "node scripts/ops/queue-health.mjs"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "devDependencies": {
    "typescript": "^5.2.2",
    "turbo": "^1.12.1",
    "prettier": "^3.1.0",
    "husky": "^9.0.0",
    "vitest": "^4.1.8",
    "dotenv": "^16.3.1",
    "@playwright/test": "^1.45.0",
    "supertest": "^7.2.2",
    "@testing-library/react": "^14.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@supabase/supabase-js": "^2.35.0"
  }
}
